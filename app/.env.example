# Wi-Fight settings. Copy this file to ".env" and fill in what you have.
# The .env file stays on your computer. Git ignores it, so a key can never be committed by accident.

# Groq API key (https://console.groq.com/keys). Turns on the language model for chat, reports, and bill reading.
GROQ_API_KEY=

# Optional: Anthropic API key. If both keys are set, Claude is used.
ANTHROPIC_API_KEY=

# Optional: Groq model names. Change these if Groq retires a model.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: force one backend: claude, groq, local, or none. Default: the first one available.
# WIFIGHT_PROVIDER=

# Optional: local model through Ollama (no key needed), and the port.
# The small model (gemma3:4b) is the default on machines with less than 24 GB of memory.
# The larger one answers better but needs about 8 GB free: WIFIGHT_LOCAL_MODEL=gemma3:12b
# WIFIGHT_LOCAL_MODEL=gemma3:4b
# PORT=4810
